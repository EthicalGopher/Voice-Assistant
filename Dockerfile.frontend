# Stage 1: Build React Frontend UI
FROM node:20-alpine AS builder
WORKDIR /app

# Copy manifest and install Node dependencies
COPY package.json package-lock.json ./
RUN npm ci

# Copy source code and build production dist bundle
COPY index.html vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json ./
COPY src ./src
COPY public ./public

# Build frontend with relative backend path for Nginx reverse proxy
ENV VITE_BACKEND_URL=""
RUN npm run build

# Stage 2: Nginx Web Server for Frontend
FROM nginx:alpine AS runner
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
